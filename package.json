{
  "name": "@ttab/elephant-ui",
  "description": "UI package created around Shadcn/ui, primarily for the Elephant project.",
  "private": false,
  "version": "1.4.6",
  "license": "MIT",
  "type": "module",
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./icons": {
      "types": "./dist/components/icons/index.d.ts",
      "import": "./dist/icons.es.js",
      "require": "./dist/icons.cjs.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/utils.es.js",
      "require": "./dist/utils.cjs.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --cache",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@types/react": "^18.3 || ^19.0",
    "@types/react-dom": "^18.3 || ^19.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/inter": "5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.576.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@ttab/eslint-config-elephant": "^1.0.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.34.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
